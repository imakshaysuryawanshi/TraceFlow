# TraceFlow backend environment variables — example template.
# 1. cp .env.example .env
# 2. Fill in at least one API key below.
# NEVER commit .env — it is gitignored.

# AI provider API keys (pick whichever providers you use)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# CORS origins allowed to call the backend (comma-separated). For production,
# list the exact frontend origin(s), e.g. https://traceflow.example.com.
# Do NOT use "*" with credentials in production.
CORS_ORIGINS=http://localhost:3080,http://127.0.0.1:3080

# Rate limiting — requests per minute per client IP for the endpoints that
# can spend paid LLM tokens (/api/execute) or CPU (/api/parse).
RATE_LIMIT_EXECUTE_PER_MINUTE=30
RATE_LIMIT_PARSE_PER_MINUTE=60

# Set to "false" to disable rate limiting (not recommended outside local dev).
# RATE_LIMIT_ENABLED=true

# Comma-separated IPs of reverse proxies that sit in front of the backend.
# Only traffic from these peers is trusted to carry the real client IP in the
# X-Forwarded-For header (rightmost entry). Leave unset when running directly.
# TRUSTED_PROXIES=127.0.0.1
