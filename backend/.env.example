# TraceFlow backend environment variables — example template.
# 1. cp .env.example .env
# 2. Fill in at least one API key below.
# NEVER commit .env — it is gitignored.

# AI provider API keys (pick whichever providers you use)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# CORS origins allowed to call the backend (comma-separated). "*" allows all.
CORS_ORIGINS=*
